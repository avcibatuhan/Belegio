# Dependencies
node_modules/

# Build output
dist/
dist-ssr/

# Secrets — never commit these
.env
.env.*
!.env.example
.mcp.json
*.local
*.local.bak
providers.json

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
*.swp

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# Belegio: never commit real receipt data (tax records / personal data)
belege/
uploads/
scans/
exports/
*.receipt.json

# TypeScript build info
*.tsbuildinfo

# Tesseract language model (downloaded at runtime / cached by browser)
*.traineddata
